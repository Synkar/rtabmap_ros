<?xml version="1.0" encoding="utf-8" ?>
<launch>
  <arg name="use_sim_time"              default="true" />
  <arg name="respawn"                   default="true" />
  <arg name="respawn_delay"             default="10" />
  <arg name="output"                    default="log" />

  <arg name="enable_rtabmap"            default="true" />
  <arg name="enable_rgbd_sync"          default="true" />
  <arg name="decompress_color"          default="true" />

  <!-- tf configs -->
  <arg name="publish_tf"                default="true" />
  <arg name="approximate_sync"          default="true" />
  <arg name="base_frame_id"             default="base_link" />
  <arg name="odom_frame_id"             default="odom" />
  <arg name="map_frame_id"              default="map" />

  <!-- map file name prefix -->
  <arg name="default_map_id"            default="$(optenv MAP_ID map)"/> 

  <!-- rtabmap configs -->
  <arg name="localization_mode"         default="true" />
  <arg name="database_path"             default="$(optenv RESOURCES_PATH /data)/maps/$(arg default_map_id).db" />
  <arg name="rtabmap_log_fname"         default="$(eval eval ('_' + '_import_' + '_(\'datetime\')').datetime.now().strftime('%Y-%m-%d-%H-%M-%S'))"/>
  <arg name="rtabmap_args"              value="--uerror --uwarn --logfilea $(optenv ROS_LOG_DIR /tmp)/rtabmap_$(arg rtabmap_log_fname).log" if="$(arg localization_mode)" />
  <arg name="rtabmap_args"              value="-d --uerror --uwarn --logfilea $(optenv ROS_LOG_DIR /tmp)/rtabmap_$(arg rtabmap_log_fname).log" unless="$(arg localization_mode)" />

  <!-- namespaces & sensor names -->
  <arg name="sensors_namespace"         default="sensors" />
  <arg name="cameras_namespace"         default="cameras" />
  <arg name="sensor_fusion_namespace"   default="sensor_fusion" />

  <arg name="front_depth_camera_name"   default="front_depth" />
  

  <arg name="slam_manager"              default="slam_manager" />

  <arg     if="$(arg respawn)" name="bond" value="" />
  <arg unless="$(arg respawn)" name="bond" value="--no-bond" />

  <node pkg="nodelet" type="nodelet" name="$(arg slam_manager)" args="manager" output="$(arg output)" clear_params = "true" respawn="$(arg respawn)" respawn_delay="$(arg respawn_delay)"/>

  <param name="use_sim_time" value="$(arg use_sim_time)" />

  <node if="$(arg decompress_color)" name="republish_front_depth_camera" type="republish" pkg="image_transport"
    args="compressed in:=$(arg sensors_namespace)/$(arg cameras_namespace)/$(arg front_depth_camera_name)/color/image_rect raw out:=$(arg sensors_namespace)/$(arg cameras_namespace)/$(arg front_depth_camera_name)/color/image_rect" />

  <node if="$(arg enable_rgbd_sync)" pkg="nodelet" type="nodelet" name="$(arg front_depth_camera_name)_rgbd_sync"
      args="load rtabmap_sync/rgbd_sync $(arg slam_manager) $(arg bond)" respawn="$(arg respawn)"  respawn_delay="$(arg respawn_delay)" output="$(arg output)" clear_params = "true">
    <param name="approximate_sync"  value="true" />

    <remap from="rgb/image"         to="$(arg sensors_namespace)/$(arg cameras_namespace)/$(arg front_depth_camera_name)/color/image_rect" />
    <remap from="rgb/camera_info"   to="$(arg sensors_namespace)/$(arg cameras_namespace)/$(arg front_depth_camera_name)/color/camera_info" />
    <remap from="depth/image"       to="$(arg sensors_namespace)/$(arg cameras_namespace)/$(arg front_depth_camera_name)/aligned_depth_to_color/image_raw" />
    <remap from="rgbd_image"        to="$(arg sensors_namespace)/$(arg cameras_namespace)/$(arg front_depth_camera_name)/rgbd_image" />
  </node>

  <!-- RTABMAP -->
  <node if="$(arg enable_rtabmap)" pkg="nodelet" type="nodelet" name="rtabmap" 
    args="load rtabmap_slam/rtabmap $(arg slam_manager) $(arg bond) $(arg rtabmap_args)" respawn="$(arg respawn)"  respawn_delay="$(arg respawn_delay)" output="$(arg output)" clear_params = "true">    
    <rosparam file="$(find rtabmap_examples)/launch/config/sdx/common.yaml" command="load" subst_value="true" />
    <rosparam unless="$(arg localization_mode)" file="$(find rtabmap_examples)/launch/config/sdx/mapping_mode.yaml" command="load" subst_value="true" />

    <!-- Operational Params -->
    <param name="database_path"               value="$(arg database_path)" />

    <param name="frame_id"                    value="$(arg base_frame_id)" />
    <param name="odom_frame_id"               value="$(arg odom_frame_id)" />
    <param name="map_frame_id"                value="$(arg map_frame_id)" />
    <param name="publish_tf"                  value="$(arg publish_tf)" />
    <param name="approx_sync"                 value="$(arg approximate_sync)" />
    <param name="wait_for_transform"          value="true" />
    <param name="wait_for_transform_duration" value="0.5" />

    <param name="subscribe_rgbd"              value="true" />
    <param name="subscribe_rgb"               value="false" />
    <param name="subscribe_stereo"            value="false" />
    <param name="subscribe_depth"             value="false" />
    <param name="subscribe_scan_cloud"        value="false" />
    <param name="gen_scan"                    value="true" />
    <param name="queue_size"                  value="30" />
    <param name="rgbd_cameras"                value="1" />
    <param name="map_always_update"           value="false" />

    <remap from="odom"            to="/$(arg sensor_fusion_namespace)/local/odom_filtered" />
    <remap from="rgb/camera_info" to="/$(arg sensors_namespace)/$(arg cameras_namespace)/$(arg front_depth_camera_name)/color/camera_info" />
    <remap from="rgb/image"       to="/$(arg sensors_namespace)/$(arg cameras_namespace)/$(arg front_depth_camera_name)/color/image_rect" />
    <remap from="rgbd_image"      to="/$(arg sensors_namespace)/$(arg cameras_namespace)/$(arg front_depth_camera_name)/rgbd_image" />

    <remap from="grid_map"        to="map" />
  </node>
</launch>
